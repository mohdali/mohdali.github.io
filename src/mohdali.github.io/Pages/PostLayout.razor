@inherits PostLayoutBase
@layout MainLayout

@if (BlogPost is not null)
{
    <SocialMeta Title="@($"{BlogPost.Title} - mohdali.dev")"
                Description="@GetDescription()"
                Type="article"
                Path="@BlogPost.Url"
                ImageUrl="@BlogPost.Image"
                ImageAlt="@BlogPost.ImageAlt"
                ImageType="@BlogPost.ImageType"
                ImageWidth="@BlogPost.ImageWidth"
                ImageHeight="@BlogPost.ImageHeight"
                PublishedTime="@BlogPost.Timestamp" />
}

<div class="post-detail-container">
    <MudContainer MaxWidth="MaxWidth.Medium" Class="py-8">
        <CascadingValue Value="this">
            <div class="post-header mb-6">
                <MudText Typo="Typo.subtitle2" Class="post-date mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Size="Size.Small" Class="mr-1"/>
                    Published: @BlogPost?.Timestamp.ToString("dd MMMM yyyy")
                </MudText>
                <MudText Typo="Typo.h1" Class="post-detail-title">@BlogPost?.Title</MudText>
                @if (BlogPost?.Tags.Length > 0)
                {
                    <div class="tag-list post-tag-list" aria-label="Post tags">
                        @foreach (var tag in BlogPost.Tags)
                        {
                            <TagLink Tag="@tag" />
                        }
                    </div>
                }
            </div>
            
            <PageTitle>@BlogPost?.Title - mohdali.dev</PageTitle>
            
            <article class="post-content-wrapper">
                <CascadingValue Value="@summary">
                    <div class="post-content post">
                        @Body
                    </div>
                </CascadingValue>
            </article>

            @if (BlogPost is not null)
            {
                var relatedPosts = GetRelatedPosts();
                var adjacentPosts = GetAdjacentPosts();
                var relatedTitle = relatedPosts.Any(HasSharedTags) ? "Related Posts" : "More Posts";

                <section class="post-discovery" aria-label="Post navigation">
                    @if (relatedPosts.Count > 0)
                    {
                        <section class="related-posts" aria-labelledby="related-posts-title">
                            <MudText Typo="Typo.h2" HtmlTag="h2" id="related-posts-title" Class="post-discovery-title">
                                @relatedTitle
                            </MudText>
                            <div class="related-post-list">
                                @foreach (var post in relatedPosts)
                                {
                                    var hasCardImage = !string.IsNullOrWhiteSpace(post.CardImage);

                                    <article class="related-post-item @(hasCardImage ? "has-preview-image" : null)">
                                        <time datetime="@post.Timestamp.ToString("yyyy-MM-dd")">@post.Timestamp.ToString("dd MMM yyyy")</time>
                                        @if (hasCardImage)
                                        {
                                            <PostPreviewImage Post="@post" Class="related-post-image-link" />
                                        }
                                        <div class="related-post-copy">
                                            <MudText Typo="Typo.h3" HtmlTag="h3">
                                                <MudLink Href="@post.Url">@post.Title</MudLink>
                                            </MudText>
                                            @if (!string.IsNullOrWhiteSpace(post.Description))
                                            {
                                                <MudText Typo="Typo.body2">@post.Description</MudText>
                                            }
                                        </div>
                                    </article>
                                }
                            </div>
                        </section>
                    }

                    @if (adjacentPosts.Previous is not null || adjacentPosts.Next is not null)
                    {
                        <nav class="post-neighbors" aria-label="Previous and next posts">
                            @if (adjacentPosts.Previous is not null)
                            {
                                <MudLink Href="@adjacentPosts.Previous.Url" Class="post-neighbor previous-post">
                                    <span>Previous</span>
                                    <strong>@adjacentPosts.Previous.Title</strong>
                                </MudLink>
                            }
                            @if (adjacentPosts.Next is not null)
                            {
                                <MudLink Href="@adjacentPosts.Next.Url" Class="post-neighbor next-post">
                                    <span>Next</span>
                                    <strong>@adjacentPosts.Next.Title</strong>
                                </MudLink>
                            }
                        </nav>
                    }
                </section>
            }
            
            <div class="post-footer mt-6">
                <MudDivider Class="mb-4"/>
                <div class="d-flex justify-space-between align-center">
                    <MudButton Variant="Variant.Text" 
                               StartIcon="@Icons.Material.Filled.ArrowBack" 
                               Color="Color.Primary"
                               Href="/posts">
                        Back to Posts
                    </MudButton>
                    <div class="post-share">
                        <MudText Typo="Typo.body2" Class="mr-2 d-inline">Share:</MudText>
                        <MudIconButton Icon="@Icons.Custom.Brands.Twitter" 
                                      Size="Size.Small"
                                      Color="Color.Primary"
                                      Target="_blank"
                                      Href="@GetTwitterShareUrl()" />
                        <MudIconButton Icon="@Icons.Custom.Brands.LinkedIn" 
                                      Size="Size.Small"
                                      Color="Color.Primary"
                                      Target="_blank"
                                      Href="@GetLinkedInShareUrl()" />
                    </div>
                </div>
            </div>
        </CascadingValue>
    </MudContainer>
</div>

@code {
    [Inject] BlogPostService BlogPostService { get; set; } = default!;

    private string GetDescription()
    {
        return !string.IsNullOrWhiteSpace(BlogPost?.Description)
            ? BlogPost.Description
            : $"Read {BlogPost?.Title} on mohdali.dev.";
    }

    private string GetTwitterShareUrl()
    {
        var title = Uri.EscapeDataString(BlogPost?.Title ?? "");
        var url = $"https://mohdali.dev{BlogPost?.Url}";
        return $"https://twitter.com/intent/tweet?text={title}&url={Uri.EscapeDataString(url)}";
    }
    
    private string GetLinkedInShareUrl()
    {
        var url = $"https://mohdali.dev{BlogPost?.Url}";
        return $"https://www.linkedin.com/sharing/share-offsite/?url={Uri.EscapeDataString(url)}";
    }

    private List<BlogPost> GetRelatedPosts()
    {
        if (BlogPost is null)
        {
            return new List<BlogPost>();
        }

        return BlogPostService.GetRelatedPosts(typeof(Program).Assembly, BlogPost);
    }

    private (BlogPost? Previous, BlogPost? Next) GetAdjacentPosts()
    {
        if (BlogPost is null)
        {
            return (null, null);
        }

        return BlogPostService.GetAdjacentPosts(typeof(Program).Assembly, BlogPost);
    }

    private bool HasSharedTags(BlogPost post)
    {
        if (BlogPost is null)
        {
            return false;
        }

        return BlogPost.Tags.Any(tag => post.Tags.Contains(tag, StringComparer.OrdinalIgnoreCase));
    }
}
