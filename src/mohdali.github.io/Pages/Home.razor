@page "/"

<PageTitle>mohdali.dev - Software notes by Mohamed Ali</PageTitle>
<SocialMeta Title="mohdali.dev"
            Description="Personal notes from Mohamed Ali on software engineering, developer tools, data visualization, and small experiments."
            Path="/" />

<MudContainer MaxWidth="MaxWidth.Large" Class="home-page">
    <section class="intro-section" aria-labelledby="home-title">
        <div>
            <MudText Typo="Typo.h1" HtmlTag="h1" Class="intro-title" id="home-title">Mohamed Ali</MudText>
            <MudText Typo="Typo.body1" HtmlTag="p" Class="intro-copy">
                Notes on software engineering, developer tools, data visualization, and small experiments that make ideas easier to inspect.
                I write about the tradeoffs behind real projects: what changed, what broke, what was worth keeping, and the evidence that shaped the next iteration.
            </MudText>
        </div>
        <div class="intro-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/posts" StartIcon="@Icons.Material.Filled.Article">
                Browse Posts
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/rss.xml" Target="_blank" StartIcon="@Icons.Material.Filled.RssFeed">
                RSS
            </MudButton>
            <MudIconButton Icon="@Icons.Custom.Brands.GitHub"
                           Color="Color.Primary"
                           Href="https://github.com/mohdali"
                           Target="_blank"
                           aria-label="GitHub profile" />
        </div>
    </section>

    <section id="latest-posts" class="posts-section" aria-labelledby="latest-posts-title">
        <div class="section-heading">
            <MudText Typo="Typo.h2" HtmlTag="h2" id="latest-posts-title">Latest Posts</MudText>
            <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/posts" EndIcon="@Icons.Material.Filled.ArrowForward">
                Archive
            </MudButton>
        </div>

        @if (BlogPosts.Count == 0)
        {
            <MudPaper Class="empty-state" Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.Article" Size="Size.Large" Color="Color.Primary" />
                <MudText Typo="Typo.h5">No posts yet</MudText>
                <MudText Typo="Typo.body1">New writing will appear here after publication.</MudText>
            </MudPaper>
        }
        else
        {
            <div class="home-post-list">
                @foreach (var blogPost in BlogPosts)
                {
                    var hasCardImage = !string.IsNullOrWhiteSpace(blogPost.CardImage);
                    <article class="blog-card home-post-card @(hasCardImage ? "has-preview-image" : null)">
                        <PostPreviewImage Post="@blogPost" Class="post-card-image-link" />
                        <div class="post-card-main">
                            <div class="post-card-meta">
                                <time datetime="@blogPost.Timestamp.ToString("yyyy-MM-dd")">@blogPost.Timestamp.ToString("dd MMM yyyy")</time>
                            </div>
                            <MudText Typo="Typo.h3" HtmlTag="h3" Class="post-card-title">
                                <MudLink Href="@blogPost.Url">@blogPost.Title</MudLink>
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(blogPost.Description))
                            {
                                <MudText Typo="Typo.body1" Class="post-card-description">@blogPost.Description</MudText>
                            }
                        </div>
                        @if (blogPost.Tags.Length > 0)
                        {
                            <div class="tag-list" aria-label="Post tags">
                                @foreach (var tag in blogPost.Tags)
                                {
                                    <TagLink Tag="@tag" />
                                }
                            </div>
                        }
                        <MudButton Href="@blogPost.Url"
                                   Variant="Variant.Text"
                                   Color="Color.Primary"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Class="read-more-btn">
                            Read
                        </MudButton>
                    </article>
                }
            </div>
        }
    </section>
</MudContainer>

@code {
    [Inject] BlogPostService blogPostService { get; set; } = default!;

    private List<BlogPost> BlogPosts = new();

    protected override void OnInitialized()
    {
        BlogPosts = blogPostService.GetPublishedBlogPosts(typeof(Program).Assembly)
            .Take(3)
            .ToList();
    }
}
