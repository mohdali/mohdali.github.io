@page "/tags/{TagSlug}"

<PageTitle>@DocumentTitle</PageTitle>
<SocialMeta Title="@DocumentTitle"
            Description="@MetaDescription"
            Path="@TagPath" />

<MudContainer MaxWidth="MaxWidth.Large" Class="archive-page tag-page">
    <header class="page-header">
        <MudText Typo="Typo.h1" HtmlTag="h1">@Heading</MudText>
        <MudText Typo="Typo.body1">@HeaderCopy</MudText>
    </header>

    @if (Tag is null)
    {
        <MudPaper Class="empty-state" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.LocalOffer" Size="Size.Large" Color="Color.Primary" />
            <MudText Typo="Typo.h5">No matching tag</MudText>
            <MudButton Variant="Variant.Text"
                       Color="Color.Primary"
                       Href="/posts"
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                Back to Posts
            </MudButton>
        </MudPaper>
    }
    else
    {
        <div class="archive-list">
            @foreach (var group in Posts.GroupBy(post => post.Timestamp.Year).OrderByDescending(group => group.Key))
            {
                <section class="archive-year" aria-labelledby="@($"tag-{Tag.Slug}-{group.Key}")">
                    <MudText Typo="Typo.h2" HtmlTag="h2" id="@($"tag-{Tag.Slug}-{group.Key}")">@group.Key</MudText>
                    <div class="archive-items">
                        @foreach (var post in group.OrderByDescending(post => post.Timestamp).ThenBy(post => post.Title))
                        {
                            var hasCardImage = !string.IsNullOrWhiteSpace(post.CardImage);

                            <article class="archive-item @(hasCardImage ? "has-preview-image" : null)">
                                <time datetime="@post.Timestamp.ToString("yyyy-MM-dd")">@post.Timestamp.ToString("dd MMM")</time>
                                @if (hasCardImage)
                                {
                                    <PostPreviewImage Post="@post" Class="archive-post-image-link" />
                                }
                                <div>
                                    <MudText Typo="Typo.h3" HtmlTag="h3">
                                        <MudLink Href="@post.Url">@post.Title</MudLink>
                                    </MudText>
                                    @if (!string.IsNullOrWhiteSpace(post.Description))
                                    {
                                        <MudText Typo="Typo.body2">@post.Description</MudText>
                                    }
                                    @if (post.Tags.Length > 0)
                                    {
                                        <div class="tag-list compact" aria-label="Post tags">
                                            @foreach (var tag in post.Tags)
                                            {
                                                <TagLink Tag="@tag" />
                                            }
                                        </div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>
    }
</MudContainer>

@code {
    [Parameter] public string TagSlug { get; set; } = string.Empty;

    [Inject] private BlogPostService BlogPostService { get; set; } = default!;

    private BlogTag? Tag { get; set; }
    private List<BlogPost> Posts { get; set; } = new();

    private string TagPath => string.IsNullOrWhiteSpace(Tag?.Slug)
        ? $"/tags/{TagSlug}"
        : $"/tags/{Tag.Slug}";

    private string Heading => Tag is null
        ? "Tag not found"
        : $"Posts tagged {Tag.Name}";

    private string DocumentTitle => Tag is null
        ? "Tag not found - mohdali.dev"
        : $"Posts tagged {Tag.Name} - mohdali.dev";

    private string HeaderCopy => Tag is null
        ? "The requested tag does not match any published posts."
        : $"{Tag.PostCount} {Pluralize(Tag.PostCount, "post")} found.";

    private string MetaDescription => Tag is null
        ? "No posts were found for the requested tag on mohdali.dev."
        : $"Posts tagged {Tag.Name} on mohdali.dev.";

    protected override void OnParametersSet()
    {
        Tag = BlogPostService.GetTag(typeof(Program).Assembly, TagSlug);
        Posts = Tag is null
            ? new List<BlogPost>()
            : BlogPostService.GetPublishedBlogPostsByTag(typeof(Program).Assembly, Tag.Slug);
    }

    private static string Pluralize(int count, string singular)
    {
        return count == 1 ? singular : $"{singular}s";
    }
}
